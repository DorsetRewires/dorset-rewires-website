# Holding mode ("coming soon"), with ONE exception: the instant quote tool stays
# public so Pete can price jobs on it and customers can self-serve a rough quote.
#
# CRITICAL Cloudflare Pages rule: clean URLs are ON, so NEVER put .html in a
# destination. A rewrite whose target ends in .html (e.g. /holding.html) makes
# the asset layer 308-redirect to the clean URL (/holding), and that loops
# forever. Every destination below is therefore a clean URL with no .html.

# Quote tool served at its clean URL (self-rewrite exempts it from the catch-all).
# /quote.html is mapped to /quote too, so the PWA start_url (/quote.html?source=pwa)
# and any .html link reach the calculator instead of being swept into the catch-all.
/quote                           /quote                           200
/quote.html                      /quote                           200

# Decap CMS admin stays reachable so Pete can edit site content (reviews).
# Editing/committing is gated by GitHub OAuth, so exposing the static admin is
# safe. The splat serves admin files directly; /admin/relay.html 308s once to the
# clean /admin/relay (which Cloudflare serves natively), preserving the OAuth
# token in the URL hash.
/admin                           /admin/                          200
/admin/*                         /admin/:splat                    200

/assets/*                        /assets/:splat                   200
/data/*                          /data/:splat                     200
/manifest.json                   /manifest.json                   200
/quote-tool-service-worker.js    /quote-tool-service-worker.js    200

# Pete-only daily checklist (noindex). Stable URL so it can be bookmarked on the phone.
/daily                           /daily                           200
/daily.html                      /daily                           200

# Pete-only review-request tool (noindex). Bookmarkable on the phone; used after a job.
/review-request                  /review-request                  200
/review-request.html             /review-request                  200

# --- Live SEO pages: carved out of holding so Google can crawl and rank them. ---
# Canonical = root clean URL (Pete's choice, 2026-06-20). The page files live in
# /pages/, so serve each at its root URL with a 200 rewrite. Destinations are clean
# (NO .html - that 308-loops). Both the clean URL and the .html form are mapped, so
# the existing relative footer links between these pages keep resolving.
/house-rewires-bournemouth            /pages/house-rewires-bournemouth            200
/house-rewires-bournemouth.html       /pages/house-rewires-bournemouth            200
/house-rewires-poole                  /pages/house-rewires-poole                  200
/house-rewires-poole.html             /pages/house-rewires-poole                  200
/house-rewire-cost-guide-dorset-2026       /pages/house-rewire-cost-guide-dorset-2026   200
/house-rewire-cost-guide-dorset-2026.html  /pages/house-rewire-cost-guide-dorset-2026   200

# Homepage carved out of holding (2026-06-21) so it can be indexed and start the SEO
# clock. Self-rewrite (source = dest, NO .html) exempts / from the catch-all, exactly
# like /quote below. Header-trace / after deploy to confirm 200 + no loop.
/                                /                                200

# Crawl files must serve themselves, NOT the holding page (the catch-all would
# otherwise rewrite them to /holding and Google would get HTML instead of the sitemap).
/robots.txt                      /robots.txt                      200
/sitemap.xml                     /sitemap.xml                     200

# Everything else: serve the holding page in place at its clean URL (no loop)
/*                               /holding                         200
