# Holding mode ("coming soon"), with ONE exception: the instant quote tool stays
# public so Pete can price jobs on it and customers can self-serve their own price.
#
# CRITICAL Cloudflare Pages rule: clean URLs are ON, so NEVER put .html in a
# destination. A rewrite whose target ends in .html (e.g. /holding.html) makes
# the asset layer 308-redirect to the clean URL (/holding), and that loops
# forever. Every destination below is therefore a clean URL with no .html.

# Quote tool served at its clean URL (self-rewrite exempts it from the catch-all).
# /quote.html is mapped to /quote too, so the PWA start_url (/quote.html?source=pwa)
# and any .html link reach the calculator instead of being swept into the catch-all.
/quote                           /quote                           200
/quote.html                      /quote                           200

# Decap CMS admin stays reachable so Pete can edit site content (reviews).
# Editing/committing is gated by GitHub OAuth, so exposing the static admin is
# safe. The splat serves admin files directly; /admin/relay.html 308s once to the
# clean /admin/relay (which Cloudflare serves natively), preserving the OAuth
# token in the URL hash.
/admin                           /admin/                          200
/admin/*                         /admin/:splat                    200

/assets/*                        /assets/:splat                   200
/data/*                          /data/:splat                     200
/manifest.json                   /manifest.json                   200
/quote-tool-service-worker.js    /quote-tool-service-worker.js    200

# Pete-only daily checklist (noindex). Stable URL so it can be bookmarked on the phone.
/daily                           /daily                           200
/daily.html                      /daily                           200

# Pete-only review-request tool (noindex). Bookmarkable on the phone; used after a job.
/review-request                  /review-request                  200
/review-request.html             /review-request                  200

# Public reviews page carved out so the sitewide "Reviews" nav link works. Shows an
# honest "awaiting reviews" state for now; kept OUT of sitemap.xml until it has content.
/reviews                         /reviews                         200
/reviews.html                    /reviews                         200

